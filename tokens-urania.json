{
  "$description": "Design tokens Urânia v1.0 (outubro de 2026). Instagram em px sobre canvas de 1080 px; A4 em pt; Canva A4 = pt x 1,333. Ocre como texto somente sobre azul profundo.",
  "color": {
    "$type": "color",
    "azul": {
      "profundo": {
        "$value": "#1D1F26",
        "$description": "Base. Texto principal e fundos escuros. CMYK C100 M65 Y0 K90; Pantone 532 C (aprox.)."
      },
      "noite": {
        "$value": "#15161B",
        "$description": "Auxiliar digital: fundo de modo escuro em telas."
      }
    },
    "ocre": {
      "base": {
        "$value": "#C58A2B",
        "$description": "Acento, máximo 5 a 10% da peça. Texto somente sobre azul profundo. CMYK C0 M35 Y100 K20; Pantone 3547 C (aprox.)."
      }
    },
    "cinza": {
      "base": {
        "$value": "#444444",
        "$description": "Texto secundário sobre fundos claros. CMYK K85; Pantone 446 C (aprox.)."
      },
      "claro": {
        "$value": "#B9B7B0",
        "$description": "Auxiliar: texto secundário sobre azul profundo."
      }
    },
    "branco": {
      "quente": {
        "$value": "#F7F6F3",
        "$description": "Fundo principal. No impresso, usar o próprio papel."
      }
    },
    "neutro": {
      "base": {
        "$value": "#D9D9D6",
        "$description": "Linhas e divisões. CMYK K20; Pantone Cool Gray 1 C."
      },
      "quente": {
        "$value": "#E8E2D6",
        "$description": "Fundo editorial (papel). CMYK C5 M5 Y10 K5; Pantone 9226 C (aprox.)."
      }
    },
    "linha": {
      "escura": {
        "$value": "#33353D",
        "$description": "Auxiliar: fio sutil sobre azul profundo."
      }
    }
  },
  "semantic": {
    "$type": "color",
    "fundo": {
      "principal": {
        "$value": "{color.branco.quente}"
      },
      "editorial": {
        "$value": "{color.neutro.quente}"
      },
      "escuro": {
        "$value": "{color.azul.profundo}"
      }
    },
    "texto": {
      "principal": {
        "$value": "{color.azul.profundo}"
      },
      "secundario": {
        "$value": "{color.cinza.base}"
      },
      "inverso": {
        "$value": "{color.branco.quente}"
      },
      "secundario-inverso": {
        "$value": "{color.cinza.claro}"
      },
      "micro-sobre-claro": {
        "$value": "{color.azul.profundo}"
      },
      "micro-sobre-escuro": {
        "$value": "{color.ocre.base}"
      }
    },
    "acento": {
      "$value": "{color.ocre.base}"
    },
    "linha": {
      "sutil": {
        "$value": "{color.neutro.base}"
      },
      "estrutural": {
        "$value": "{color.azul.profundo}"
      },
      "sobre-neutro-quente": {
        "$value": "{color.cinza.base}"
      },
      "sobre-escuro": {
        "$value": "{color.linha.escura}"
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "logo": {
        "$value": "Playfair Display",
        "$description": "Somente no logotipo URANIA, aplicado como arquivo."
      },
      "expressiva": {
        "$value": [
          "Cormorant Garamond",
          "Georgia",
          "serif"
        ]
      },
      "sistema": {
        "$value": [
          "Manrope",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ]
      },
      "micro": {
        "$value": [
          "Manrope",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ],
        "$description": "Microinformação em Manrope Medium, caixa alta, espaçamento 0,16em."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      }
    }
  },
